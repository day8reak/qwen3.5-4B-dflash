{
  "schema_version": 2,
  "contract_id": "qwen3.5-4b-dflash-npu-rollback-benchmark",
  "scope": "batch-1 strict-greedy ordinary incremental versus transactional DFlash rollback",
  "prerequisites": {
    "real_npu_required": true,
    "cpu_fallback_allowed": false,
    "strict_greedy_token_mismatches_allowed": 0,
    "correctness_gate_runs_before_timing": true,
    "historical_prefix_replay_during_verify": false
  },
  "case_identity": [
    "Git revision and source hashes",
    "Target and Draft checkpoint hashes",
    "NPU model and device index",
    "CANN, driver, firmware, torch and torch_npu versions",
    "prompt token hash and thinking mode",
    "max_new_tokens and block_size (anchor included)",
    "kv_cache_max_len and prefill/decode chunk sizes"
  ],
  "runner": {
    "entrypoint": "python -B -m models.dflash_v1.benchmark_npu",
    "modes": [
      "ordinary",
      "dflash"
    ],
    "separate_process_per_mode": true,
    "warmup_iterations": 3,
    "measured_iterations": 10,
    "synchronize_before_and_after_each_iteration": true,
    "stable_result_required_for_every_iteration": true,
    "retain_all_measurements": true,
    "latency_summary": [
      "min",
      "max",
      "mean",
      "median",
      "p90",
      "population_stdev"
    ]
  },
  "msprof": {
    "wrapper": "tools/run_msprof.sh",
    "diagnostic_not_baseline": true,
    "recommended_warmup_iterations": 1,
    "recommended_measured_iterations": 1,
    "default_options": {
      "ascendcl": "on",
      "runtime-api": "on",
      "task-time": "on",
      "aicpu": "on",
      "ai-core": "on",
      "aic-mode": "task-based",
      "aic-metrics": "PipeUtilization",
      "msproftx": "on"
    },
    "separate_metric_passes": [
      "PipeUtilization",
      "Memory",
      "MemoryUB"
    ]
  },
  "route_boundary": {
    "ordinary": "persistent target-state incremental greedy",
    "dflash": "persistent target state with T=K+1 verify, state rollback, and bounded commit",
    "block_size_contract": "B includes one anchor; B=16 means K=15 proposals",
    "not_claimed": [
      "Draft KV-cache performance",
      "custom causal-conv bank operator performance",
      "fused full-vocabulary Top-1 head performance",
      "future fused rollback cache-update performance"
    ]
  }
}
